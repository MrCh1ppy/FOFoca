from datetime import date
from . import AdvanceOutcome, Market, Order, Snapshot

class NotInitializedError(RuntimeError): ...
class AlreadyInitializedError(RuntimeError): ...
class FinishedError(RuntimeError): ...
class MarketConflictError(RuntimeError): ...

class Session:
    def __init__(self) -> None: ...
    def initialize(self, start_date: date, end_date: date, initial_cash: str) -> None: ...
    def account(self) -> Snapshot: ...
    def advance_day(self, orders: list[Order], market: Market) -> AdvanceOutcome: ...
    def report(self) -> None: ...
