# Local development copy — DO NOT commit real credentials.
# The deployment script reads a file in this shape from a path outside the repository.

# psycopg/libpq connection string for the dedicated fofoca database.
# Use a least-privilege role that owns only the fofoca tables.
FOFOCA_DATABASE_URL=postgresql://fofoca_app:CHANGE_ME@127.0.0.1:5432/fofoca

# Optional: seconds to sleep between consecutive provider calls.
# Default 1.0. Keep >= 0.5 to be polite to the AKShare/EastMoney endpoints.
FOFOCA_REQUEST_DELAY_SECONDS=1.0

# Optional: best-effort per-request transport timeouts (seconds).
# AKShare 1.18.97 issues plain requests.get() calls with NO timeout; the
# provider injects timeout=(connect, read) while active. Best-effort only —
# see README.md "Fetch timeouts (best-effort) and the hard external bound".
FOFOCA_CONNECT_TIMEOUT_SECONDS=10
FOFOCA_READ_TIMEOUT_SECONDS=60
